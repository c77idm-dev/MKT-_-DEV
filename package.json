{
  "name": "devolucoes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:int": "vitest run --config vitest.int.config.mts",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "node --env-file=.env --import tsx scripts/migrar.ts",
    "usuario:criar": "node --env-file=.env --import tsx scripts/criar-usuario.ts",
    "test:e2e": "playwright test",
    "ml:autorizar": "node --env-file=.env --import tsx scripts/ml/autorizar.ts",
    "ml:trocar-codigo": "node --env-file=.env --import tsx scripts/ml/trocar-codigo.ts",
    "ml:spike": "node --env-file=.env --import tsx scripts/ml/spike.ts",
    "build:scripts": "esbuild scripts/migrar.ts scripts/criar-usuario.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs --external:@node-rs/argon2 --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "papaparse": "5.7.0",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.14",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fflate": "0.8.2",
    "jsdom": "^31.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
